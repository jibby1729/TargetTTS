\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Median WER (\%) for all models across SIR and overlap conditions. \textbf  {Bold} indicates the best extraction model per row. \textit  {Curriculum Easy} was trained on overlap $\leq 0.3$ only; \textit  {Curriculum Medium} extends to overlap $\leq 0.5$ via warm-start fine-tuning; \textit  {Curriculum Hard} resumes from Medium and trains across all overlaps with weights $[1,1,1,2,2,3]$.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:all-models}{{1}{5}{Median WER (\%) for all models across SIR and overlap conditions. \textbf {Bold} indicates the best extraction model per row. \textit {Curriculum Easy} was trained on overlap $\leq 0.3$ only; \textit {Curriculum Medium} extends to overlap $\leq 0.5$ via warm-start fine-tuning; \textit {Curriculum Hard} resumes from Medium and trains across all overlaps with weights $[1,1,1,2,2,3]$}{table.1}{}}
