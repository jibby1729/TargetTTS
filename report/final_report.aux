\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Baseline: overlap degrades ASR across languages}{4}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces WER vs.\ overlap ratio for English (left, Whisper-tiny, clean baseline 8.1\%) and Twi (right, fine-tuned Whisper-small, clean baseline 34.7\%) at three SIR levels. Both languages show the same degradation pattern: WER increases with overlap ratio and decreases with SIR. At 0\,dB SIR with full overlap, English WER exceeds 100\%. This confirms the problem is language-agnostic.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:baseline-wer}{{2}{4}{WER vs.\ overlap ratio for English (left, Whisper-tiny, clean baseline 8.1\%) and Twi (right, fine-tuned Whisper-small, clean baseline 34.7\%) at three SIR levels. Both languages show the same degradation pattern: WER increases with overlap ratio and decreases with SIR. At 0\,dB SIR with full overlap, English WER exceeds 100\%. This confirms the problem is language-agnostic}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Training and WER evaluation}{4}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Median WER vs.\ overlap ratio for baseline (no extraction), hybrid loss ($\alpha = 0.1$), and power-law reconstruction loss only ($\alpha = 0$) at 0\,dB SIR (left) and 5\,dB SIR (right). Both extraction models reduce WER at overlap ratios $\geq 0.3$, with the largest gains at full overlap.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:extraction-wer}{{3}{4}{Median WER vs.\ overlap ratio for baseline (no extraction), hybrid loss ($\alpha = 0.1$), and power-law reconstruction loss only ($\alpha = 0$) at 0\,dB SIR (left) and 5\,dB SIR (right). Both extraction models reduce WER at overlap ratios $\geq 0.3$, with the largest gains at full overlap}{figure.3}{}}
